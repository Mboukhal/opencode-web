# Local development (not used by Coolify)

PORT=8099
DATA_DIR=/tmp/opencode-dev
PUBLIC_BASE_URL=http://localhost:8099
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=lios80466@gmail.com

# OpenCode CLI + config
OPENCODE_BIN=$HOME/.opencode/bin/opencode
OPENCODE_CONFIG_DIR=$HOME/.config
OPENCODE_STATE_DIR=$HOME/.local/share
OPENCODE_MODEL=opencode/muse-spark-1.3
OPENCODE_TIMEOUT=30m

# Shared OpenCode server. 0.0.0.0 lets a phone on the same Wi-Fi reach it;
# leave the port empty and OpenCode picks a free one.
OPENCODE_SERVICE_HOST=0.0.0.0
OPENCODE_SERVICE_PORT=
# Set to pair through a tunnel instead of PUBLIC_BASE_URL.
MOBILE_PAIR_URL=

# Git / GitHub over SSH
SSH_KEY_PATH=$HOME/.ssh/id_ed25519
GITHUB_ORGS=login:Mboukhal
GIT_AUTHOR_NAME=Mohammed Boukhal
GIT_AUTHOR_EMAIL=lios80466@gmail.com

# Local skills copied into $OPENCODE_CONFIG_DIR/opencode/skills on boot.
SKILLS_SRC=$HOME/.config/opencode/skills

# Provider API keys, stored as OpenCode credentials on boot.
# Format: provider=key separated by ';'. Never commit real keys.
PROVIDER_KEYS=
# e.g. PROVIDER_KEYS=openrouter=sk-or-...;openai=sk-...

# Extra environment for the OpenCode server and agent children (KEY=value;KEY=value).
OPENCODE_ENV=

# Security headers
FORCE_HTTPS=0
HSTS_MAX_AGE=0
EXTRA_CSP_ORIGINS=
